# PostgreSQL connection string
# Railway provides this automatically as DATABASE_URL — no manual setup needed in production.
# For local development, copy this file to .env.local and fill in your values.
#
#   Railway:  Dashboard → Project → your Postgres service → Connect → "Prisma" tab
#   Local:    Use a local Postgres instance or a Railway preview environment
#
DATABASE_URL="postgresql://user:password@host:5432/next_portal?sslmode=require"

# Optional: direct (non-pooled) connection for Prisma migrations.
# Required only if you are using a connection pooler like PgBouncer or Railway's proxy.
# DIRECT_URL="postgresql://user:password@host:5432/next_portal?sslmode=require"

# ─── Email ────────────────────────────────────────────────────────────────────
# Controls which email backend is used for @mention and other notification emails.
# In-app notifications (the bell icon) always work regardless of this setting.
#
# Supported values:
#   disabled         — logs intent, never sends externally (safe default for dev/staging)
#   microsoft_graph  — Microsoft Graph API (requires AZURE_* vars below)
#   resend           — Resend SDK (requires RESEND_API_KEY; kept as a fallback option)
#
EMAIL_PROVIDER=disabled

# Public app URL — used to build deep links inside notification emails.
NEXT_PUBLIC_APP_URL="https://your-app-url.com"

# ─── Feature Flags ────────────────────────────────────────────────────────────
# Org Chart / Workforce Planning beta module.
# Set to "true" to enable the /org-chart route and nav item during development.
# Remove or set to "false" to hide the module in production.
# NEXT_PUBLIC_ORG_CHART_ENABLED=false

# ─── Authentication: Microsoft Entra ID (Auth.js) ─────────────────────────────
# Microsoft authenticates the user; NEXT Portal still authorizes them (a valid
# Microsoft login only grants access if an ACTIVE Portal user exists — see the Users
# admin page). Register a single-tenant app in Entra; the client secret is server-side
# only — never prefix it with NEXT_PUBLIC_.
#
# AUTH_SECRET is shared with the existing session signing (already required below).
# AUTH_URL / AUTH_TRUST_HOST are needed on Railway because the app runs behind a proxy.
#
# AUTH_SECRET=                                   # already required; used by Auth.js too
# AUTH_MICROSOFT_ENTRA_ID_ID=                    # Entra application (client) ID
# AUTH_MICROSOFT_ENTRA_ID_SECRET=                # Entra client secret (server-side only)
# AUTH_MICROSOFT_ENTRA_ID_ISSUER=https://login.microsoftonline.com/<MASON_TENANT_ID>/v2.0
# AUTH_URL=https://portal.masontechnologies.app  # this environment's base URL (staging differs)
# AUTH_TRUST_HOST=true                           # required behind Railway's proxy

# ─── Maintenance lockout (emergency) ──────────────────────────────────────────
# Locks the ENTIRE portal to a single master account. When enabled:
#   • all logins are refused except MASTER_EMAIL using MASTER_PASSWORD, and
#   • existing 30-day sessions for everyone else stop working on their next request.
# Reversible: set MAINTENANCE_MODE=off (or remove it) to restore normal access.
#
# MAINTENANCE_MODE=off                       # "on" | "off" (default off)
# MASTER_EMAIL=you@yourdomain.com            # must be an existing user in the portal
# MASTER_PASSWORD=change-me-to-a-strong-secret

# ─── Microsoft Graph (EMAIL_PROVIDER=microsoft_graph) ─────────────────────────
# Register an app in Azure AD with Mail.Send permission (application, not delegated).
# AZURE_TENANT_ID=
# AZURE_CLIENT_ID=
# AZURE_CLIENT_SECRET=
# GRAPH_FROM_EMAIL=notifications@yourdomain.com

# ─── Resend fallback (EMAIL_PROVIDER=resend) ──────────────────────────────────
# Only needed if switching back to Resend. Verify your sending domain in resend.com first.
# RESEND_API_KEY=re_...
# RESEND_FROM_EMAIL="NEXT Portal <notifications@yourdomain.com>"
